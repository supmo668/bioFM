+# --------------------------------------------------------------------------- #
+# T5b · stereo guard (principal ruling 2026-09-15, dispatch #98)
+# --------------------------------------------------------------------------- #
+#
+# Real snapshot InChIs, NOT hand-written SMILES: the first stage-by-stage probe of
+# rolipram used a stand-in structure and concluded the R/S pair survived every
+# stage. It was not rolipram, and the conclusion was worthless (#97). Every pair
+# below is copied verbatim from data/raw/drugbank/drugbank.tsv.
+#
+# Ruling: reject any canonicalisation step that alters stereo. If the tautomer
+# step changes or erases a stereo layer (/b /t /m /s) of the pre-tautomer InChI,
+# return the PRE-tautomer InChIKey. Compare InChI stereo LAYERS, not InChIKey
+# blocks — the tautomer step legitimately moves the H-layer, which lives in the
+# first key block, so key-block comparison cannot isolate stereo.
+
+#: (name, snapshot InChI, InChIKey of the pre-tautomer structure) — the key the
+#: guard must return. Pinned literals (rdkit 2026.3.5), same rule as
+#: GOLDEN_CANONICAL_KEYS: if one moves, the rdkit pin moved.
+STEREO_PAIRS = {
+    "threonine": (
+        # DB00156 L-Threonine — a NON-standard `InChI=1/` at source, `/s2`
+        ("InChI=1/C4H9NO3/c1-2(6)3(5)4(7)8/h2-3,6H,5H2,1H3,(H,7,8)/t2-,3+/s2", "AYFVYJQAPQTCCC-STHAYSLISA-N"),
+        # DB03700 D-Threonine
+        ("InChI=1S/C4H9NO3/c1-2(6)3(5)4(7)8/h2-3,6H,5H2,1H3,(H,7,8)/t2-,3-/m1/s1", "AYFVYJQAPQTCCC-PWNYCUMCSA-N"),
+    ),
+    "isoleucine": (
+        # DB00167 L-Isoleucine
+        ("InChI=1S/C6H13NO2/c1-3-4(2)5(7)6(8)9/h4-5H,3,7H2,1-2H3,(H,8,9)/t4-,5-/m0/s1", "AGPKZVBTJJNPAG-WHFBIAKZSA-N"),
+        # DB01739 Allo-Isoleucine
+        ("InChI=1S/C6H13NO2/c1-3-4(2)5(7)6(8)9/h4-5H,3,7H2,1-2H3,(H,8,9)/t4-,5+/m1/s1", "AGPKZVBTJJNPAG-UHNVWZDZSA-N"),
+    ),
+    "aspartate": (
+        # DB00128 L-Aspartic Acid — `/m0`; the CTO's confirmed pipeline collapse (#97)
+        ("InChI=1S/C4H7NO4/c5-2(4(8)9)1-3(6)7/h2H,1,5H2,(H,6,7)(H,8,9)/t2-/m0/s1", "CKLJMWTZIZZHCS-REOHCLBHSA-N"),
+        # DB02655 D-Aspartic Acid — `/m1`
+        ("InChI=1S/C4H7NO4/c5-2(4(8)9)1-3(6)7/h2H,1,5H2,(H,6,7)(H,8,9)/t2-/m1/s1", "CKLJMWTZIZZHCS-UWTATZPHSA-N"),
+    ),
+}
+
+
+@pytest.mark.parametrize("pair", sorted(STEREO_PAIRS))
+def test_t5b_stereo_guard_keeps_enantiomers_and_diastereomers_distinct(pair):
+    """L-/D-threonine, L-/allo-isoleucine and L-/D-aspartate are DIFFERENT
+    compounds. Before the guard all three pairs collapsed to one key at the
+    tautomer step (46 of the 48 tautomer-stage merge groups on the real snapshot
+    had stereo before that step)."""
+    (a, _), (b, _) = STEREO_PAIRS[pair]
+    assert canonical_inchikey(a) != canonical_inchikey(b)
+
+
+@pytest.mark.parametrize(
+    "inchi,expected",
+    sorted(v for pair in STEREO_PAIRS.values() for v in pair),
+)
+def test_t5b_stereo_guard_returns_the_pre_tautomer_key(inchi, expected):
+    """When the guard fires it returns the PRE-tautomer InChIKey — the key of the
+    salt-stripped, neutralised structure with its stereo intact — not some third
+    value. Pinned so `!=` above cannot be satisfied by returning garbage."""
+    assert canonical_inchikey(inchi) == expected
+
+
+#: DB00348 Nitisinone and DB08307, its enol tautomer — byte-DIFFERENT source InChIs
+#: (`/h4-6,12H` vs `/h4-6,21H`), no stereo layer on either. One of exactly two
+#: stereo-free tautomer-stage merge groups on the real snapshot.
+NITISINONE_KETO = (
+    "InChI=1S/C14H10F3NO5/c15-14(16,17)7-4-5-8(9(6-7)18(22)23)13(21)12-10(19)2-1-3-11(12)20"
+    "/h4-6,12H,1-3H2"
+)
+NITISINONE_ENOL = (
+    "InChI=1S/C14H10F3NO5/c15-14(16,17)7-4-5-8(9(6-7)18(22)23)13(21)12-10(19)2-1-3-11(12)20"
+    "/h4-6,21H,1-3H2"
+)
+
+
+def test_t5b_stereo_free_tautomer_pair_still_merges():
+    """The guard must not disable tautomer canonicalisation: a pair that differs
+    ONLY in tautomeric form, with no stereo to lose, still collapses to one key."""
+    assert canonical_inchikey(NITISINONE_KETO) == canonical_inchikey(NITISINONE_ENOL)
+
+
