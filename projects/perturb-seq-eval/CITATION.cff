# `version` and `date-released` name the latest PUBLISHED release, 0.6.1. The title and abstract
# above are already those of the 0.6.2 manuscript (Amendment 6), which is prepared and NOT
# published (approvals row 41: preparation and dry run only). 0.6.2 has no DOI and no release
# date yet; after both publishes, publish.yml's deposit-time step 5 sets `version: "0.6.2"`,
# `date-released` and the two new DOIs here. Until then none is written.
version: "0.6.1"
date-released: "2026-11-22"
