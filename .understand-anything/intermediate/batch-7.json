      "summary": "Package barrel for the MassGen extractor draft that re-exports project_confidence and project_severity as the public API of the extractors package.",
      "tags": [
        "entry-point",
        "barrel",
        "package-init"
      ],
      "complexity": "simple",
      "languageNotes": "Python package __init__ using relative imports and an explicit __all__ list to define the public surface."
