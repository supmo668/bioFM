    {
      "id": "file:projects/perturb-seq-eval/massgen_skill_draft/extractors/confidence.py",
      "type": "file",
      "name": "confidence.py",
      "filePath": "projects/perturb-seq-eval/massgen_skill_draft/extractors/confidence.py",
      "summary": "Deterministic, LLM-free projection of per-agent confidence from a round's peer votes: each agent's confidence is its share of non-self votes, with the denominator adjusted for abstaining voters.",
      "tags": [
        "utility",
        "voting",
        "confidence-projection",
        "multi-agent",
        "pure-function"
      ],
      "complexity": "simple",
      "languageNotes": "Uses a typing.Protocol (AgentVoteLike) for structural duck-typing so any object with voter_id/voted_for attributes is accepted without importing MassGen's concrete AgentVote class."
    },
    {
      "id": "file:projects/perturb-seq-eval/massgen_skill_draft/extractors/severity.py",
      "type": "file",
      "name": "severity.py",
      "filePath": "projects/perturb-seq-eval/massgen_skill_draft/extractors/severity.py",
      "summary": "LLM-driven severity projection that builds an N x (N-1) critic-vs-target severity matrix from vote reasons via an injected rater backend, with a per-call cache for repeated reasons and a default prior for missing reasons.",
      "tags": [
        "utility",
        "llm-rater",
        "severity-projection",
        "multi-agent",
        "dependency-injection"
      ],
      "complexity": "moderate",
      "languageNotes": "The rater is an abstract Callable[[str], float] injected by the caller; RaterBackend is a type alias and AgentVoteLike is a structural Protocol, keeping the module free of MassGen imports."
    },
    {
      "id": "file:projects/perturb-seq-eval/massgen_skill_draft/extractors/test_extractors_skeleton.py",
      "type": "file",
      "name": "test_extractors_skeleton.py",
      "filePath": "projects/perturb-seq-eval/massgen_skill_draft/extractors/test_extractors_skeleton.py",
      "summary": "Pytest acceptance-test skeleton for the extractor package, covering vote-share confidence rules (unanimity, self-vote exclusion, abstention) and severity matrix shape, reason caching, and missing-reason fallback using a FakeVote dataclass and stub raters.",
      "tags": [
        "test",
        "pytest",
        "acceptance-test",
        "voting",
        "multi-agent"
      ],
      "complexity": "moderate",
      "languageNotes": "Tests are named after the behaviour they enforce (MassGen TDD contract); closures over a dict counter are used to count rater invocations."
    },
