      "filePath": "projects/perturb-seq-eval/massgen_skill_draft/extractors/severity.py",
      "lineRange": [
        32,
        78
      ],
      "summary": "Builds an N x (N-1) severity matrix where each voter's rated reason is assigned to every non-chosen target; renders the prompt template once per distinct reason, clamps the rater output to [0,1], and uses DEFAULT_SEVERITY_ON_MISSING_REASON when the reason is empty.",
      "tags": [
        "utility",
