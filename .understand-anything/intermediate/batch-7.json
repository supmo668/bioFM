    {
      "id": "function:projects/perturb-seq-eval/massgen_skill_draft/extractors/confidence.py:project_confidence",
      "type": "function",
      "name": "project_confidence",
      "filePath": "projects/perturb-seq-eval/massgen_skill_draft/extractors/confidence.py",
      "lineRange": [
        25,
        48
      ],
      "summary": "Computes a confidence score per agent as the fraction of distinct peer voters who voted for it, ignoring self-votes and votes for unknown agents, and shrinking the denominator when voters abstain.",
      "tags": [
        "utility",
        "voting",
        "confidence-projection",
        "pure-function"
      ],
      "complexity": "simple"
    },
