      "type": "file",
      "name": "iterative_revision.py",
      "filePath": "research/test-time-compute-guide/ref_impl/iterative_revision.py",
      "summary": "Reference sequential revision strategy: generates an initial draft, repeatedly feeds it through a Reviser, scores each draft with a Verifier, and stops early when the score improvement falls below a threshold or max_rounds is reached.",
      "tags": [
        "test-time-compute",
        "iterative-revision",
        "strategy",
        "reference-implementation"
      ],
      "complexity": "simple"
    },
    {
