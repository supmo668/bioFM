      "filePath": "research/test-time-compute-guide/ref_impl/types.py",
      "summary": "Minimal shared types for all reference implementations: the frozen Candidate dataclass (text plus token cost) and the Generator, Verifier, and Reviser structural Protocols that strategies accept as callables.",
      "tags": [
        "type-definition",
        "protocol",
        "data-model",
        "test-time-compute"
      ],
      "complexity": "simple",
      "languageNotes": "Uses typing.Protocol so any plain function with the right signature (including test fixtures) satisfies Generator/Verifier/Reviser without inheritance."
