      "id": "file:research/test-time-compute-guide/ref_impl/weighted_majority.py",
      "type": "file",
      "name": "weighted_majority.py",
      "filePath": "research/test-time-compute-guide/ref_impl/weighted_majority.py",
      "summary": "Reference verifier-weighted majority strategy: each candidate contributes its Verifier score to its projected equivalence class, the class with the highest total score wins, and the highest-scoring member of that class is returned; degenerates to plain majority vote when all scores are equal.",
