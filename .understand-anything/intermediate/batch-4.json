    {
      "id": "file:research/test-time-compute-guide/ref_impl/adaptive_budget.py",
      "type": "file",
      "name": "adaptive_budget.py",
      "filePath": "research/test-time-compute-guide/ref_impl/adaptive_budget.py",
      "summary": "Implements Snell et al.'s compute-optimal adaptive routing: a small probe batch is scored by the verifier, the prompt's difficulty is classified from the probe mean and spread, and the remaining budget is dispatched to iterative revision (easy), best-of-N (hard), or weighted majority (medium).",
      "tags": [
        "test-time-compute",
        "adaptive-routing",
        "strategy",
        "orchestrator",
        "reference-implementation"
      ],
      "complexity": "moderate",
      "languageNotes": "Composes the other three strategies; Difficulty is a str-backed Enum and AdaptiveResult a frozen dataclass."
    },
    {
      "id": "file:research/test-time-compute-guide/ref_impl/best_of_n.py",
      "type": "file",
      "name": "best_of_n.py",
      "filePath": "research/test-time-compute-guide/ref_impl/best_of_n.py",
      "summary": "Reference Best-of-N strategy: draws n independent candidates from a Generator, scores each with a Verifier, and returns the argmax along with all candidates, scores, and total token cost.",
      "tags": [
        "test-time-compute",
        "best-of-n",
        "strategy",
        "reference-implementation"
      ],
      "complexity": "simple"
    },
    {
