      "type": "file",
      "name": "majority_vote.py",
      "filePath": "research/test-time-compute-guide/ref_impl/majority_vote.py",
      "summary": "Reference self-consistency / majority-vote strategy (Wang et al. 2022): samples n candidates, groups them by a pluggable answer projection, and returns the exemplar of the most populous equivalence class with per-class counts.",
      "tags": [
        "test-time-compute",
        "majority-vote",
        "self-consistency",
        "strategy",
        "reference-implementation"
      ],
