      "type": "file",
      "name": "bayesian.py",
      "filePath": "paper_standalone/src/perturb_eval/bayesian.py",
      "summary": "Bayesian MAP recommender that maps a 4-d probe signature to an orchestrator Config under a FLOPs budget using per-config diagonal Gaussian likelihoods fitted on calibration logs and an exponential prior favouring smaller configs.",
      "tags": [
        "bayesian-inference",
        "recommender",
        "hyperparameter-tuning",
        "data-model",
        "numpy"
      ],
      "complexity": "moderate",
      "languageNotes": "Log-space posterior computation for numerical stability; backs off to global mean/variance for configs with fewer than 2 calibration samples."
    },
    {
      "id": "file:paper_standalone/src/perturb_eval/calibration.py",
      "type": "file",
      "name": "calibration.py",
      "filePath": "paper_standalone/src/perturb_eval/calibration.py",
      "summary": "Fits the four Task Difficulty Index (TDI) coefficients via a small ridge regression against difficulty labels from logged RunTrace records, clipping and renormalising weights so TDI stays in [0, 1].",
      "tags": [
        "calibration",
        "regression",
        "hyperparameter-tuning",
        "numpy"
      ],
      "complexity": "moderate",
      "languageNotes": "Closed-form ridge solve (A^T A + lambda I)^-1 A^T b via numpy.linalg.solve rather than an iterative optimiser."
    },
