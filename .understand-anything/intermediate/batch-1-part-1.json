  {
   "id": "file:projects/perturb-seq-eval/src/perturb_eval/bayesian.py",
   "type": "file",
   "name": "bayesian.py",
   "filePath": "projects/perturb-seq-eval/src/perturb_eval/bayesian.py",
   "summary": "Bayesian MAP recommender that maps a 4-d probe signature to a recommended orchestrator Config under a FLOPs budget, using per-config Gaussian likelihoods with diagonal covariance and a size-favouring prior computed in log-space.",
   "tags": [
    "bayesian-inference",
    "recommender",
    "hyperparameter-tuning",
    "numpy"
   ],
   "complexity": "moderate",
   "languageNotes": "Log-space posterior (log prior + Gaussian log-likelihood) with diagonal covariance chosen for small calibration sets; public API designed so a full-covariance or mixture model can be swapped in."
  },
  {
   "id": "file:projects/perturb-seq-eval/src/perturb_eval/calibration.py",
   "type": "file",
   "name": "calibration.py",
   "filePath": "projects/perturb-seq-eval/src/perturb_eval/calibration.py",
   "summary": "Fits Task Difficulty Index (TDI) coefficients from labelled RunTrace records via a small ridge regression over per-run metric features, producing a TDICoeffs record.",
   "tags": [
    "calibration",
    "regression",
    "metrics",
    "training"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses closed-form ridge regression (np.linalg.solve with lambda*I) rather than OLS for robustness at small N."
  },
  {
